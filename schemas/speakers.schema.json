{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/speakers.schema.json",
  "title": "Speakers Contract",
  "description": "User-maintained speaker labels, local voice references, and subtitle palette.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "speakers", "unknown_palette"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "speakers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["display", "color"],
        "properties": {
          "display": {"type": "string", "minLength": 1, "maxLength": 80},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "track": {"type": "string", "minLength": 1, "maxLength": 120},
          "voice_profile": {"type": "string", "minLength": 1, "maxLength": 260}
        }
      }
    },
    "unknown_palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
    }
  }
}
