{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/verify_report.schema.json",
  "title": "Verification Report Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passed",
    "checks",
    "fix_suggestions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "passed",
          "threshold",
          "measured",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "enum": [
              "click_discontinuity",
              "level_step",
              "pacing",
              "clipped_word",
              "removed_percent"
            ]
          },
          "scope": {
            "enum": [
              "join",
              "cut",
              "run"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "passed": {
            "type": "boolean"
          },
          "threshold": {
            "type": "number"
          },
          "measured": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "fix_suggestions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_id",
          "code",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "code": {
            "enum": [
              "widen_crossfade",
              "move_cut_to_silence",
              "review_word_alignment",
              "reduce_removed_percent"
            ]
          },
          "suggested_value_ms": {
            "type": "number",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
