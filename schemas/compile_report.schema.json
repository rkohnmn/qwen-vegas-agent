{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/compile_report.schema.json",
  "title": "Compile Report Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_frames",
    "removed_frames",
    "removed_percent",
    "warnings",
    "rejected_items",
    "snaps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "source_frames": {
      "type": "integer",
      "minimum": 1
    },
    "removed_frames": {
      "type": "integer",
      "minimum": 0
    },
    "removed_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^W_[A-Z0-9_]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "rejected_items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "code": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "snaps": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "word_time",
          "final_time_frame",
          "delta_ms",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:c[0-9]+(?:_j[0-9]+)?_(?:in|out)|c[0-9]+)$"
          },
          "word_time": {
            "type": "number",
            "minimum": 0
          },
          "final_time_frame": {
            "type": "integer",
            "minimum": 0
          },
          "delta_ms": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "final_time": {
            "type": "string",
            "pattern": "^[0-9]+/[1-9][0-9]*$"
          }
        }
      }
    },
    "fade_decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "frames",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "decision": {
            "enum": [
              "crossfade",
              "fade_out_in",
              "none"
            ]
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
