{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/compile_report.schema.json",
  "title": "Compile Report Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_frames",
    "removed_frames",
    "removed_percent",
    "warnings",
    "rejected_items",
    "item_outcomes",
    "snaps"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "source_frames": {
      "type": "integer",
      "minimum": 1
    },
    "removed_frames": {
      "type": "integer",
      "minimum": 0
    },
    "removed_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "warnings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^W_[A-Z0-9_]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "rejected_items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "code": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "item_outcomes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "item_type",
          "status"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "item_type": {
            "enum": [
              "cut",
              "gap_action",
              "transition",
              "sfx",
              "effect"
            ]
          },
          "status": {
            "enum": [
              "applied",
              "adjusted",
              "rejected"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "delta_frames": {
            "type": "integer",
            "minimum": 1
          },
          "adjustment_db": {
            "type": "number",
            "not": {
              "const": 0
            }
          },
          "catalog_key": {
            "type": "string",
            "pattern": "^(tr|vfx|afx|txt|sfx)\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"
          },
          "target_event_id": {
            "type": "string",
            "pattern": "^e[0-9]+$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "gain_db": {
            "type": "number",
            "minimum": -60,
            "maximum": 6
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "adjusted"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "anyOf": [
                {
                  "required": [
                    "delta_frames"
                  ]
                },
                {
                  "required": [
                    "adjustment_db"
                  ]
                }
              ],
              "not": {
                "required": [
                  "code"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "rejected"
                }
              }
            },
            "then": {
              "required": [
                "code",
                "reason"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "delta_frames"
                    ]
                  },
                  {
                    "required": [
                      "adjustment_db"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "applied"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "code"
                    ]
                  },
                  {
                    "required": [
                      "delta_frames"
                    ]
                  },
                  {
                    "required": [
                      "adjustment_db"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "snaps": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "word_time",
          "final_time_frame",
          "delta_ms",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:c[0-9]+(?:_j[0-9]+)?_(?:in|out)|c[0-9]+)$"
          },
          "word_time": {
            "type": "number",
            "minimum": 0
          },
          "final_time_frame": {
            "type": "integer",
            "minimum": 0
          },
          "delta_ms": {
            "type": "number"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "final_time": {
            "type": "string",
            "pattern": "^[0-9]+/[1-9][0-9]*$"
          }
        }
      }
    },
    "fade_decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "frames",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "decision": {
            "enum": [
              "crossfade",
              "fade_out_in",
              "none"
            ]
          },
          "frames": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "sfx_used": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "license"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^sfx\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  }
}
