{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/captions.schema.json",
  "title": "Edited Timeline Captions Contract",
  "description": "Code-produced, frame-resolved captions. Speaker colors are resolved from speakers.json and are not accepted here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fps",
    "duration_frames",
    "captions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "fps": {
      "type": "string",
      "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1
    },
    "captions": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker_key",
          "text",
          "start_frame",
          "end_frame",
          "style_key",
          "emphasis",
          "confidence_flags",
          "source_word_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cap[0-9]+$"
          },
          "speaker_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "style_key": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^txt\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"
              }
            ]
          },
          "emphasis": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "word_ids",
                "mode",
                "start_codepoint",
                "end_codepoint"
              ],
              "properties": {
                "word_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 40,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^w[0-9]+$"
                  }
                },
                "mode": {
                  "enum": [
                    "bold",
                    "italic",
                    "uppercase",
                    "highlight"
                  ]
                },
                "start_codepoint": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_codepoint": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            }
          },
          "confidence_flags": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "enum": [
                "low_speaker_conf",
                "overlap",
                "unknown_speaker",
                "profanity_masked"
              ]
            }
          },
          "source_word_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^w[0-9]+$"
            }
          }
        }
      }
    }
  }
}
