{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-vegas-agent.local/schemas/ops.schema.json",
  "title": "Vegas Operations Contract",
  "description": "Compiler-produced frame-resolved executor operations. Paths, colors, and plugin IDs are permitted only in this internal contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "header", "operations"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "working_copy_path", "fps", "source_hashes"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
        "working_copy_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "fps": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1, "maxLength": 80},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "marker_id", "frame", "label"], "properties": {"op": {"const": "add_marker"}, "marker_id": {"type": "string", "pattern": "^m[0-9]+$"}, "frame": {"type": "integer", "minimum": 0}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "region_id", "start_frame", "end_frame", "label"], "properties": {"op": {"const": "add_region"}, "region_id": {"type": "string", "pattern": "^r[0-9]+$"}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 0}, "label": {"type": "string", "minLength": 1, "maxLength": 240}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "frame", "group_ids"], "properties": {"op": {"const": "split"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "frame": {"type": "integer", "minimum": 0}, "group_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 80}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "start_frame", "end_frame", "track_ids"], "properties": {"op": {"const": "delete_range"}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 0}, "track_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 80}}, "group_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 80}}, "item_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "from_frame", "frame_count", "track_ids"], "properties": {"op": {"const": "close_gap"}, "from_frame": {"type": "integer", "minimum": 0}, "frame_count": {"type": "integer", "minimum": 1}, "track_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "maxLength": 80}}, "group_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 80}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "start_frame", "length_frames"], "properties": {"op": {"const": "trim"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "start_frame": {"type": "integer", "minimum": 0}, "length_frames": {"type": "integer", "minimum": 0}, "take_offset_frames": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "direction", "frames", "curve"], "properties": {"op": {"const": "set_fade"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "direction": {"enum": ["in", "out"]}, "frames": {"type": "integer", "minimum": 0}, "curve": {"enum": ["linear", "fast", "slow", "smooth"]}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "left_event_id", "right_event_id", "catalog_key", "plugin_unique_id", "duration_frames"], "properties": {"op": {"const": "add_transition"}, "left_event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "right_event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "catalog_key": {"type": "string", "pattern": "^tr\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"}, "plugin_unique_id": {"type": "string", "minLength": 1, "maxLength": 256}, "duration_frames": {"type": "integer", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "track_id", "catalog_key", "file_path", "start_frame", "length_frames", "gain_db"], "properties": {"op": {"const": "add_audio_event"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "track_id": {"type": "string", "minLength": 1, "maxLength": 80}, "catalog_key": {"type": "string", "pattern": "^sfx\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"}, "file_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "start_frame": {"type": "integer", "minimum": 0}, "length_frames": {"type": "integer", "minimum": 0}, "gain_db": {"type": "number", "minimum": -60, "maximum": 6}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "target_type", "target_id", "gain_db"], "properties": {"op": {"const": "set_gain"}, "target_type": {"enum": ["event", "track"]}, "target_id": {"type": "string", "minLength": 1, "maxLength": 80}, "gain_db": {"type": "number", "minimum": -60, "maximum": 24}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "target_type", "target_id", "catalog_key", "plugin_unique_id", "params"], "properties": {"op": {"const": "apply_fx"}, "target_type": {"enum": ["event", "track"]}, "target_id": {"type": "string", "minLength": 1, "maxLength": 80}, "catalog_key": {"type": "string", "pattern": "^(vfx|afx)\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"}, "plugin_unique_id": {"type": "string", "minLength": 1, "maxLength": 256}, "params": {"type": "object", "maxProperties": 80, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null", "array", "object"]}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "track_id", "start_frame", "length_frames", "text"], "properties": {"op": {"const": "add_text_event"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "track_id": {"type": "string", "minLength": 1, "maxLength": 80}, "start_frame": {"type": "integer", "minimum": 0}, "length_frames": {"type": "integer", "minimum": 0}, "text": {"type": "string", "maxLength": 1000}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "event_id", "style_key", "color"], "properties": {"op": {"const": "set_text_style"}, "event_id": {"type": "string", "pattern": "^e[0-9]+$"}, "style_key": {"type": "string", "pattern": "^txt\\.[a-z0-9-]+\\.[a-f0-9]{6,12}$"}, "plugin_unique_id": {"type": "string", "minLength": 1, "maxLength": 256}, "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}, "params": {"type": "object", "maxProperties": 80, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null", "array", "object"]}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "output_path", "start_frame", "end_frame", "template_key"], "properties": {"op": {"const": "render_preview"}, "output_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 0}, "template_key": {"type": "string", "minLength": 1, "maxLength": 160}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "output_path", "template_key"], "properties": {"op": {"const": "render_final"}, "output_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "template_key": {"type": "string", "minLength": 1, "maxLength": 160}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "checkpoint_id"], "properties": {"op": {"const": "save_checkpoint"}, "checkpoint_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "prefix"], "properties": {"op": {"const": "clear_markers_by_prefix"}, "prefix": {"type": "string", "minLength": 1, "maxLength": 80}}}
      ]}
    }
  }
}
