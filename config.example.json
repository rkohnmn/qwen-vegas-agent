{
  "llm": {
    "endpoint": "https://<tailnet-host>.ts.net/v1",
    "model": "qwen",
    "context_tokens": 32768,
    "temperature": 0.2,
    "max_output_tokens": 6000,
    "use_json_schema": true,
    "request_timeout_s": 600
  },
  "asr": {
    "engine": "whisperx",
    "model": "small",
    "compute_type": "int8_float16",
    "device": "auto",
    "language": "auto"
  },
  "speakers": {
    "file": "speakers.json",
    "mode": "single",
    "diarization": {
      "enabled": false,
      "device": "cpu",
      "hf_token": ""
    },
    "unknown_similarity_threshold": 0.65
  },
  "offload": {
    "enabled": false,
    "host": "",
    "tasks": [
      "diarization",
      "scene",
      "beats",
      "sfx_index"
    ]
  },
  "compile": {
    "head_pad_ms": 40,
    "tail_pad_ms": 80,
    "min_gap_after_cut_ms": 120,
    "audio_crossfade_ms": 20,
    "max_removed_percent": 35,
    "snap_zero_crossing": true,
    "max_gap_after_cut_ms": 1800
  },
  "subtitles": {
    "max_chars_per_line": 42,
    "max_lines": 2,
    "max_cps": 20,
    "min_duration_ms": 700,
    "also_export": [
      "srt",
      "ass"
    ],
    "hold_ms": 100,
    "low_speaker_conf_threshold": 0.65,
    "show_fillers": true,
    "filler_words": ["uh", "um", "erm", "er", "hmm", "mm"],
    "profanity_policy": "keep",
    "profanity_words": [],
    "outline_color": "#000000",
    "outline_width": 2,
    "font_name": "Arial",
    "font_size": 48,
    "margin_v": 48,
    "minimum_contrast_ratio": 3,
    "renderer": "ass_burn_in"
  },
  "mode": "dry-run",
  "auto_thresholds": {
    "min_cut_confidence": 0.85,
    "max_warnings": 0
  },
  "planner": {
    "max_tool_rounds": 3,
    "max_compile_retries": 2,
    "max_verify_iterations": 2
  },
  "assets": {
    "roots": [
      "assets/"
    ],
    "github_allowlist": [],
    "pin_commits": true,
    "ask_before_other_sources": true
  },
  "vegas": {
    "transport": "script_menu",
    "work_dir": "work/",
    "render_template": ""
  },
  "paths": {
    "cache": "cache/",
    "runs": "runs/",
    "stop_file": "STOP"
  },
  "perception": {
    "gap_minimum_ms": 250,
    "gap_window_ms": 10,
    "gap_noise_floor_multiplier": 2.5,
    "gap_absolute_rms_floor": 0.002,
    "gap_minimum_quiet_ms": 40
  }
}
